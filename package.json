{
  "name": "state-tree",
  "version": "1.0.0",
  "description": "A simple tree-based state container that provides an alternative state model to redux",
  "main": "dist/state_container.js",
  "scripts": {
    "test": "jest",
    "format": "prettier --write .",
    "babel": "babel src/ -d dist/"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@babel/cli": "^7.27.2",
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.27.2",
    "babel-core": "^7.0.0-bridge.0",
    "babel-jest": "^30.2.0",
    "eslint": "^8.57.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.5.2",
    "prettier": "^3.6.2",
    "regenerator-runtime": "^0.14.1",
    "webpack": "^5.105.2"
  },
  "dependencies": {
    "immutable": "^5.1.8",
    "ramda": "^0.32.0",
    "sinon": "^22.1.0"
  },
  "eslintConfig": {
    "env": {
      "browser": true,
      "es6": true
    },
    "extends": "eslint:recommended",
    "parserOptions": {
      "sourceType": "module"
    },
    "rules": {
      "indent": [
        "error",
        4
      ],
      "linebreak-style": [
        "error",
        "unix"
      ],
      "semi": [
        "error",
        "always"
      ]
    }
  },
  "babel": {
    "presets": [
      "@babel/preset-env"
    ],
    "env": {
      "test": {
        "presets": [
          "@babel/preset-env"
        ]
      }
    }
  },
  "prettier": {
    "trailingComma": "es5",
    "bracketSameLine": true,
    "arrowParens": "avoid"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testEnvironmentOptions": {
      "customExportConditions": [
        "require",
        "default"
      ]
    }
  }
}
